          "raw": "{{baseUrl}}/api/proyecto?limite=5",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "proyecto"
          ],
          "query": [
            {
              "key": "limite",
              "value": "5"
            }
          ]
        },
        "description": "limite=0 o negativo responde 400."
      }
    },
    {
      "name": "6. Obtener por código",
      "request": {
        "method": "GET",
        "header": [],
