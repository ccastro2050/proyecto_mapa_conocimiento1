{
  "info": {
    "name": "Mapa de Conocimiento — v1 (proyecto)",
    "description": "Los 7 endpoints de la v1, en el orden del smoke test de 7_quickstart.md. Empiece con la base recién levantada: la tabla proyecto arranca vacía.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:8076"
    }
  ],
  "item": [
    {
      "name": "1. Diagnóstico",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            ""
          ]
        },
        "description": "Responde 200 con version v1."
      }
    },
    {
      "name": "2. Listar — VACÍO al arrancar",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/proyecto",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "proyecto"
          ]
        },
        "description": "Con la base recién levantada responde 204 SIN cuerpo: no hay proyectos."
      }
    },
    {
      "name": "3. Crear",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "url": {
          "raw": "{{baseUrl}}/api/proyecto",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "proyecto"
          ]
        },
        "description": "Responde 200. Repetirlo da 500: la llave la defiende la base.",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": 9001,\n  \"titulo\": \"Mapa de conocimiento institucional\",\n  \"resumen\": \"Proyecto para consolidar la produccion academica de la universidad.\",\n  \"presupuesto\": 85000000.5,\n  \"tipoFinanciacion\": \"Interna\",\n  \"tipoFondos\": \"Recurrentes\",\n  \"fechaInicio\": \"2026-02-01\",\n  \"fechaFin\": null\n}",
          "options": {
            "raw": {
              "language": "json"
            }
          }
        }
      }
    },
    {
      "name": "4. Listar — ahora con 1",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/api/proyecto",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "proyecto"
          ]
        },
        "description": "Responde 200 con total 1. El presupuesto vuelve como NÚMERO, sin comillas."
      }
    },
